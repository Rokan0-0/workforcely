# WorkforceMS Enterprise Platform Environment Configuration

# Application Branding & URL
NEXT_PUBLIC_APP_NAME="WorkforceMS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Engine Configuration (Google Gemini API Key)
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Database Connection (JSON DB / PostgreSQL / Prisma)
DATABASE_URL="file:./db.json"

# Feature Toggle Defaults (Build-Time Override)
NEXT_PUBLIC_ENABLE_LMS=true
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_HMO=true
NEXT_PUBLIC_ENABLE_DISCIPLINARY=true
NEXT_PUBLIC_ENABLE_PAYROLL=true
